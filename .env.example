# Loopback MySQL only. Copy to gitignored `.env.local`.
# Leave DATABASE_URL unset to build and run with no database.
DATABASE_URL=mysql://deploytest:deploytest@127.0.0.1:3306/deploytest

# test (default if unset) | admin | storefront
# test: noindex meta and robots.txt Disallow: /
APP_MODE=test

# Set one of these before `npm run build`. Used as deploymentId and /api/health commit.
GIT_COMMIT=
NEXT_PUBLIC_COMMIT=

# Absolute folder served at /uploads/... . Unset: that route returns 404.
UPLOADS_DIR=

# Optional source image for /api/thumb. Default: assets/sample.png
SHARP_SOURCE=

# Set to health to make /api/health return 500. Runtime only; no rebuild.
MOCK_BREAK=
